---
const year = new Date().getFullYear();
const links = [
  { label: 'Equipo', href: '/equipo' },
  { label: 'Vacantes', href: '/vacantes' },
  { label: 'Talento', href: '/talento' },
  { label: 'Contacto', href: '/contacto' },
  { label: 'Privacidad', href: '/politica-de-privacidad' },
];
---

<footer style="background: var(--color-ink-deep); color: var(--color-paper);">
  <div class="section-container" style="padding-block: var(--space-2xl, 5rem);">

    <!-- Banda principal mast-headed -->
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <span class="inline-flex items-center justify-center w-9 h-9 text-base font-bold"
                style="background: var(--color-accent); color: var(--color-paper); border-radius: var(--radius-md); font-family: var(--font-display);">J</span>
          <span class="text-2xl" style="font-family: var(--font-display); font-weight: 600;">Jesgali</span>
        </a>
        <p class="text-lg max-w-md" style="font-family: var(--font-display); color: oklch(92% 0.012 83);">
          Construimos carreras junto con las personas que eligen crecer con nosotros.
        </p>
      </div>

      <a href="mailto:contacto@jesgali.com.mx" class="link-underline text-lg" style="color: var(--color-paper);">
        contacto@jesgali.com.mx
      </a>
    </div>

    <hr style="border:0; border-top: var(--rule-hair) solid oklch(45% 0.020 50); margin-block: var(--space-lg, 2rem);" />

    <!-- Fila inferior: enlaces + redes + copyright -->
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between text-sm" style="color: oklch(80% 0.014 70);">
      <nav class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map(l => (
          <a href={l.href} class="foot-link" style="font-family: var(--font-body);">{l.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a href="#" aria-label="LinkedIn" class="foot-icon">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 11.001-4.124 2.062 2.062 0 01-.001 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="#" aria-label="Instagram" class="foot-icon">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      </div>

      <p style="font-family: var(--font-body);">© {year} Grupo Jesgali Empresarial.</p>
    </div>
  </div>
</footer>

<style>
  .foot-link { position: relative; transition: color var(--dur-base, 260ms) var(--ease-out, ease); }
  .foot-link:hover { color: var(--color-paper); }
  .foot-icon { display: inline-flex; transition: color var(--dur-base, 260ms) var(--ease-out, ease); color: oklch(80% 0.014 70); }
  .foot-icon:hover { color: var(--color-accent); }
</style>
