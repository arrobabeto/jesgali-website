---
/* Hallmark · genre: editorial · macrostructure: Split Contact · theme: custom (clay/cream/pine · Fraunces + Hanken Grotesk) · enrichment: none · nav: N6 · footer: Ft1 */
/* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 */
import Layout from '../layouts/Layout.astro';
import ConfirmationModal from '../components/ui/ConfirmationModal.astro';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() ?? '';

const datos = [
  { label: 'Correo', valor: 'contacto@jesgali.com.mx', href: 'mailto:contacto@jesgali.com.mx', pendiente: false },
  { label: 'Teléfono', valor: '— por confirmar', pendiente: true },
  { label: 'Ubicación', valor: 'Cuernavaca, Morelos', extra: 'Dirección — por confirmar', pendiente: false },
  { label: 'Horario', valor: '— por confirmar', pendiente: true },
];
---

<Layout
  title="Contacto — Grupo Jesgali Empresarial | Escríbenos"
  description="¿Tienes una pregunta, propuesta o quieres saber más sobre Grupo Jesgali? Escríbenos por correo o a través del formulario y te responderemos pronto."
>

  <!-- 1 · HERO TIPOGRÁFICO -->
  <section class="section-container" style="padding-top: var(--space-2xl); padding-bottom: var(--space-xl);">
    <p class="eyebrow reveal reveal-1" style="display: inline-flex; align-items: center; gap: 0.5rem;">
      <span style="width: 7px; height: 7px; border-radius: 9999px; background: var(--color-pine); display: inline-block;"></span>
      Hablemos
    </p>

    <h1 class="reveal reveal-2" style="font-family: var(--font-display); font-weight: 600; font-size: var(--text-display); line-height: 0.96; margin-top: 1.5rem; max-width: 15ch; overflow-wrap: anywhere; min-width: 0;">
      Ponte en <span style="color: var(--color-accent-deep);">contacto</span>
    </h1>

    <p class="reveal reveal-3" style="margin-top: 2rem; max-width: 54ch; font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">
      ¿Tienes una pregunta, una propuesta o quieres saber más sobre nosotros? Escríbenos. Leemos cada mensaje y te respondemos lo antes posible.
    </p>
  </section>

  <hr class="rule-thick" />

  <!-- 2 · SPLIT: INFO + FORMULARIO -->
  <section class="section-container" style="padding-block: var(--space-3xl);">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      <!-- Info -->
      <div class="lg:col-span-5" style="min-width: 0;">
        <p class="eyebrow" style="margin-bottom: var(--space-lg);">Datos de contacto</p>

        <div>
          {datos.map((d, i) => (
            <div style={`border-top: var(--rule-hair) solid var(--color-hairline); padding-block: 1.25rem; ${i === datos.length - 1 ? 'border-bottom: var(--rule-hair) solid var(--color-hairline);' : ''}`}>
              <p class="eyebrow" style="color: var(--color-accent-deep); margin-bottom: 0.5rem;">{d.label}</p>
              {d.href ? (
                <a href={d.href} class="link-underline" style="font-size: var(--text-md);">{d.valor}</a>
              ) : (
                <p class={d.pendiente ? 'placeholder-pending' : ''} style={d.pendiente ? '' : 'font-size: var(--text-md); color: var(--color-ink);'}>{d.valor}</p>
              )}
              {d.extra && <p class="placeholder-pending" style="margin-top: 0.25rem;">{d.extra}</p>}
            </div>
          ))}
        </div>

        <!-- Redes -->
        <div style="margin-top: var(--space-lg);">
          <p class="eyebrow" style="color: var(--color-accent-deep); margin-bottom: 0.75rem;">Síguenos</p>
          <div style="display: flex; gap: 1.5rem;">
            <a href="#" class="link-underline" style="font-size: var(--text-md);">LinkedIn</a>
            <a href="#" class="link-underline" style="font-size: var(--text-md);">Instagram</a>
          </div>
        </div>
      </div>

      <!-- Formulario -->
      <div class="lg:col-span-7" style="min-width: 0;">
        <form
          id="form-contacto"
          action="https://api.web3forms.com/submit"
          method="POST"
          style="border: var(--rule-hair) solid var(--color-hairline); border-radius: var(--radius-md); padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--color-paper);"
        >
          <input type="hidden" name="access_key" value={web3formsAccessKey} />
          <input type="hidden" name="subject" value="Contacto — Jesgali.com.mx" />
          <input type="hidden" name="from_name" value="Jesgali Sitio Web" />
          <input type="checkbox" name="botcheck" style="display: none;" />

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="field-label" for="c-nombre">Nombre completo *</label>
              <input id="c-nombre" type="text" name="nombre" required class="field-input" placeholder="Tu nombre" />
            </div>
            <div>
              <label class="field-label" for="c-email">Correo electrónico *</label>
              <input id="c-email" type="email" name="email" required class="field-input" placeholder="tu@correo.com" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5" style="margin-top: 1.25rem;">
            <div>
              <label class="field-label" for="c-tel">Teléfono</label>
              <input id="c-tel" type="tel" name="telefono" class="field-input" placeholder="55 1234 5678" />
            </div>
            <div>
              <label class="field-label" for="c-asunto">Asunto *</label>
              <input id="c-asunto" type="text" name="asunto" required class="field-input" placeholder="¿Sobre qué nos escribes?" />
            </div>
          </div>

          <div style="margin-top: 1.25rem;">
            <label class="field-label" for="c-mensaje">Mensaje *</label>
            <textarea
              id="c-mensaje"
              name="mensaje"
              required
              rows="5"
              class="field-input"
              style="resize: vertical; min-height: 8rem;"
              placeholder="Cuéntanos en qué podemos ayudarte..."
            ></textarea>
          </div>

          <div style="margin-top: 1.25rem;">
            <label class="consent-label">
              <input type="checkbox" name="consent_privacidad" required class="consent-check" />
              <span>
                He leído y acepto el
                <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer" class="link-underline" style="color: var(--color-accent-deep);">Aviso de Privacidad</a>
                y consiento el tratamiento de mis datos personales para atender mi consulta. *
              </span>
            </label>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 1.75rem;">
            Enviar mensaje
          </button>
          <p id="estado-form-contacto" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

    </div>
  </section>

  <!-- 3 · BANDA OSCURA · CTA VACANTES -->
  <section style="background: var(--color-ink-deep); color: var(--color-paper);">
    <div class="section-container" style="padding-block: var(--space-3xl); text-align: center;">
      <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; color: var(--color-paper); max-width: 22ch; margin-inline: auto; overflow-wrap: anywhere; min-width: 0;">
        ¿Buscas empleo en Jesgali?
      </h2>
      <p style="margin-top: 1.25rem; max-width: 46ch; margin-inline: auto; font-size: var(--text-md); line-height: 1.6; color: oklch(80% 0.014 70);">
        Si tu mensaje es sobre una vacante, revisa primero nuestras posiciones abiertas y aplica directamente.
      </p>
      <div style="margin-top: 2.5rem;">
        <a href="/vacantes" class="btn-white">Ver vacantes abiertas</a>
      </div>
    </div>
  </section>

  <ConfirmationModal id="modal-contacto" title="Mensaje recibido">
    <Fragment slot="description">
      Gracias por escribirnos. Te responderemos lo antes posible al correo que nos dejaste.
    </Fragment>
    <a href="mailto:contacto@jesgali.com.mx" class="link-underline" style="font-size: var(--text-md);">
      contacto@jesgali.com.mx
    </a>
  </ConfirmationModal>

</Layout>

<style>
  /* ---- Placeholder pendiente ---- */
  .placeholder-pending {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    opacity: 0.6;
    font-style: normal;
  }

  /* ---- Consentimiento privacidad ---- */
  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .consent-check {
    margin-top: 0.15rem;
    width: 1rem;
    height: 1rem;
    min-width: 1rem;
    accent-color: var(--color-accent-deep);
    cursor: pointer;
  }

  /* ---- Campos de formulario ---- */
  .field-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }
  .field-input {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-ink);
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 0.7rem 0.9rem;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .field-input:hover { border-color: var(--color-ink-soft); }
  .field-input:focus { outline: none; border-color: var(--color-accent-deep); box-shadow: 0 0 0 3px var(--color-accent-soft); }

</style>

<script>
  import { initWeb3Forms } from '../scripts/web3forms';
  import { initModal } from '../scripts/modal';

  const form = document.querySelector<HTMLFormElement>('#form-contacto');
  const status = document.querySelector<HTMLElement>('#estado-form-contacto');
  const modal = document.querySelector<HTMLElement>('#modal-contacto');
  const modalController = modal ? initModal(modal) : null;

  if (form && status) {
    initWeb3Forms({
      form,
      statusElement: status,
      submittingLabel: 'Enviando mensaje…',
      onSuccess: submitter => modalController?.open(submitter),
    });
  }
</script>
