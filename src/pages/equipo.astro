---
import Layout from '../layouts/Layout.astro';

const liderazgo = [
  { nombre: 'Gabriel Jerez', cargo: 'Director General', iniciales: 'GJ', descripcion: 'Fundador de Grupo Jesgali. Más de 15 años construyendo equipos y relaciones comerciales en el sector.' },
  { nombre: 'Ana Galindo', cargo: 'Directora de Operaciones', iniciales: 'AG', descripcion: 'Especialista en procesos operativos y cadena de suministro. Garantiza que la maquinaria funcione sin fricciones.' },
  { nombre: 'Roberto Fuentes', cargo: 'Director Comercial', iniciales: 'RF', descripcion: 'Lidera la estrategia de ventas y desarrollo de nuevos mercados. Apasionado por construir equipos comerciales de alto rendimiento.' },
];

const compromisos = [
  { eyebrow: 'Misión', texto: 'Comercializar productos de calidad que mejoren la vida de las familias mexicanas, a través de un equipo apasionado por el servicio y comprometido con la excelencia en cada operación.' },
  { eyebrow: 'Visión', texto: 'Ser la empresa de comercialización de línea blanca de referencia en México, reconocida por la calidad de su equipo, la solidez de sus relaciones comerciales y el impacto positivo en sus colaboradores.' },
  { eyebrow: 'Propósito', texto: 'Construir carreras, no solo empleos. Cada persona en Jesgali tiene acceso a las herramientas, el apoyo y las oportunidades para crecer de verdad.' },
];

const valores = [
  { titulo: 'Integridad', texto: 'Hacemos lo que decimos. Siempre. Con clientes, proveedores y entre nosotros mismos.' },
  { titulo: 'Crecimiento', texto: 'Nos exigimos mejorar constantemente: en procesos, en resultados y como personas.' },
  { titulo: 'Respeto', texto: 'Cada persona en el equipo merece ser escuchada y tratada con dignidad, sin excepción.' },
  { titulo: 'Resultados', texto: 'Medimos lo que hacemos. Los logros concretos nos guían, no las buenas intenciones.' },
];

const beneficios = [
  'Seguro de Gastos Médicos Mayores',
  'Vales de despensa (15% salario)',
  'Fondo de ahorro',
  'Vacaciones superiores a la ley',
  'Plan de carrera estructurado',
  'Capacitación continua',
  'Ambiente colaborativo y de respeto',
  'Evaluaciones semestrales de desempeño',
];

const hitos = [
  { año: '2013', evento: 'Fundación de Grupo Jesgali Empresarial en Cuernavaca, Morelos.' },
  { año: '2016', evento: 'Primer equipo comercial de 10 personas. Apertura de nuevas zonas de distribución.' },
  { año: '2019', evento: 'Expansión a nuevos segmentos de mercado. Crecimiento del equipo a 30 colaboradores.' },
  { año: '2022', evento: 'Transformación digital de procesos internos y logística. Nuevo sistema de gestión.' },
  { año: '2024', evento: 'Consolidación como referente del sector. Más de 50 colaboradores en el equipo.' },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · theme: custom (clay/cream/pine · Fraunces + Hanken Grotesk) · enrichment: none · nav: N6 · footer: Ft1 -->
<!-- Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 -->

<Layout
  title="Equipo — Grupo Jesgali Empresarial | Quiénes Somos, Historia y Beneficios"
  description="Conoce al equipo de Grupo Jesgali: nuestra historia desde 2013, misión, valores, liderazgo y los beneficios reales de trabajar en una comercializadora de línea blanca mexicana en crecimiento."
>

  <!-- 1 · HERO TIPOGRÁFICO -->
  <section class="section-container" style="padding-top: var(--space-2xl); padding-bottom: var(--space-xl); min-height: 64vh; display: flex; flex-direction: column; justify-content: center;">
    <p class="eyebrow reveal reveal-1" style="display: inline-flex; align-items: center; gap: 0.5rem;">
      <span style="width: 7px; height: 7px; border-radius: 9999px; background: var(--color-pine); display: inline-block;"></span>
      Nuestro equipo
    </p>

    <h1 class="reveal reveal-2" style="font-family: var(--font-display); font-weight: 600; font-size: var(--text-display); line-height: 0.96; margin-top: 1.5rem; max-width: 14ch; overflow-wrap: anywhere; min-width: 0;">
      Somos <span style="color: var(--color-accent-deep);">Jesgali</span>
    </h1>

    <p class="reveal reveal-3" style="margin-top: 2rem; max-width: 56ch; font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">
      Un equipo de personas comprometidas con su propio crecimiento y el de la empresa. Conoce quiénes somos, de dónde venimos y hacia dónde vamos.
    </p>
  </section>

  <hr class="rule-thick" />

  <!-- 2 · NUESTRA HISTORIA + TRAYECTORIA -->
  <section class="section-container" style="padding-block: var(--space-3xl);">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow" style="margin-bottom: 1.5rem;">Nuestra historia</p>
        <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; margin-bottom: 1.5rem; overflow-wrap: anywhere; min-width: 0; max-width: 16ch;">
          Más de una década creciendo juntos
        </h2>
        <p style="font-size: var(--text-md); line-height: 1.65; color: var(--color-ink-soft); margin-bottom: 1.25rem; max-width: 52ch;">
          Grupo Jesgali nació en 2013 con una idea clara: construir una empresa donde las personas y los negocios crezcan juntos. Lo que empezó como una operación pequeña en Cuernavaca, Morelos se ha convertido en una empresa con más de 50 colaboradores y presencia en múltiples zonas del país.
        </p>
        <p style="line-height: 1.65; color: var(--color-ink-soft); max-width: 52ch;">
          A lo largo de estos más de 10 años hemos aprendido que el verdadero activo de una empresa no está en los productos que comercializa, sino en las personas que la hacen funcionar todos los días.
        </p>
      </div>

      <div class="lg:col-span-7">
        {hitos.map((h, i) => (
          <div>
            {i > 0 && <hr class="rule-hair" />}
            <div class="grid grid-cols-12 gap-4 md:gap-8 items-baseline" style="padding-block: var(--space-lg);">
              <span class="col-span-3 md:col-span-2" style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--color-accent-deep);">{h.año}</span>
              <p class="col-span-9 md:col-span-10" style="font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">{h.evento}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · MISIÓN · VISIÓN · PROPÓSITO -->
  <section style="background: var(--color-paper-2);">
    <div class="section-container" style="padding-block: var(--space-3xl);">
      <p class="eyebrow" style="margin-bottom: var(--space-xl);">Nuestros compromisos</p>
      <div class="grid md:grid-cols-3 gap-10 md:gap-12">
        {compromisos.map(c => (
          <div style="border-top: var(--rule-thick) solid var(--color-ink); padding-top: 1.5rem;">
            <p class="eyebrow" style="color: var(--color-accent-deep); margin-bottom: 1rem;">{c.eyebrow}</p>
            <p style="font-size: var(--text-md); line-height: 1.65; color: var(--color-ink-soft);">{c.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · VALORES -->
  <section class="section-container" style="padding-block: var(--space-3xl);">
    <h2 style="font-size: var(--text-2xl); font-weight: 600; max-width: 16ch; margin-bottom: var(--space-xl); overflow-wrap: anywhere; min-width: 0;">
      Lo que nos sostiene
    </h2>
    <div class="grid sm:grid-cols-2 gap-x-12 gap-y-0">
      {valores.map((v, i) => (
        <div class="grid grid-cols-12 gap-4 items-baseline" style="border-top: var(--rule-hair) solid var(--color-hairline); padding-block: var(--space-lg);">
          <span class="col-span-2" style="font-family: var(--font-display); font-size: var(--text-md); font-weight: 600; color: var(--color-accent-deep);">0{i + 1}</span>
          <div class="col-span-10">
            <h3 style="font-size: var(--text-lg); font-weight: 600; margin-bottom: 0.5rem;">{v.titulo}</h3>
            <p style="font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">{v.texto}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5 · LIDERAZGO -->
  <section style="background: var(--color-paper-2);">
    <div class="section-container" style="padding-block: var(--space-3xl);">
      <div style="max-width: 40ch; margin-bottom: var(--space-xl);">
        <p class="eyebrow" style="margin-bottom: 1rem;">El liderazgo</p>
        <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; overflow-wrap: anywhere; min-width: 0;">
          Las personas detrás de las decisiones
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {liderazgo.map(l => (
          <div style="border-top: var(--rule-thick) solid var(--color-ink); padding-top: 1.5rem;">
            <div style="width: 56px; height: 56px; border-radius: 9999px; background: var(--color-accent); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
              <span style="font-family: var(--font-display); font-weight: 600; font-size: var(--text-lg); color: var(--color-paper);">{l.iniciales}</span>
            </div>
            <h3 style="font-size: var(--text-lg); font-weight: 600; margin-bottom: 0.25rem;">{l.nombre}</h3>
            <p class="eyebrow" style="color: var(--color-accent-deep); margin-bottom: 1rem;">{l.cargo}</p>
            <p style="font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">{l.descripcion}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 · BENEFICIOS REALES (banda oscura) -->
  <section style="background: var(--color-ink-deep); color: var(--color-paper);">
    <div class="section-container" style="padding-block: var(--space-3xl);">
      <div style="max-width: 44ch; margin-bottom: var(--space-xl);">
        <p class="eyebrow" style="color: oklch(80% 0.014 70); margin-bottom: 1rem;">Beneficios reales</p>
        <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; color: var(--color-paper); overflow-wrap: anywhere; min-width: 0;">
          Estos son algunos de nuestros beneficios
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-x-12 gap-y-0">
        {beneficios.map(b => (
          <div style="display: flex; align-items: center; gap: 1rem; padding-block: 1.125rem; border-top: var(--rule-hair) solid oklch(38% 0.020 50);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true">
              <path d="M20 6L9 17l-5-5" />
            </svg>
            <span style="font-size: var(--text-md); color: var(--color-paper);">{b}</span>
          </div>
        ))}
      </div>

      <div style="margin-top: var(--space-xl);">
        <a href="/vacantes" class="btn-white">Ver vacantes abiertas</a>
      </div>
    </div>
  </section>

  <!-- 7 · EL DÍA A DÍA -->
  <section class="section-container" style="padding-block: var(--space-3xl);">
    <div style="margin-bottom: var(--space-xl);">
      <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; max-width: 14ch; overflow-wrap: anywhere; min-width: 0;">
        El día a día en Jesgali
      </h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <div class="dia-dia-item">
        <img
          src="/images/equipo/equipo-1.avif"
          alt="Colaboradores de Grupo Jesgali Empresarial en sesión de trabajo en equipo"
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
        />
      </div>
      <div class="dia-dia-item">
        <img
          src="/images/equipo/equipo-2.avif"
          alt="Profesionales de Jesgali colaborando en un proyecto empresarial"
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
        />
      </div>
      <div class="dia-dia-item">
        <img
          src="/images/equipo/equipo-3.avif"
          alt="Ambiente de trabajo y cultura organizacional en Grupo Jesgali"
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
        />
      </div>
      <div class="dia-dia-item">
        <img
          src="/images/equipo/equipo-4.avif"
          alt="Equipo de Grupo Jesgali Empresarial en dinámica de trabajo cotidiana"
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
        />
      </div>
      <div class="dia-dia-item">
        <img
          src="/images/equipo/equipo-1.avif"
          alt="Espacio de trabajo colaborativo en Grupo Jesgali, Cuernavaca Morelos"
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
        />
      </div>
      <div class="dia-dia-item">
        <img
          src="/images/equipo/equipo-2.avif"
          alt="Talento humano de Jesgali desarrollando soluciones para sus clientes"
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
        />
      </div>
    </div>
  </section>

  <hr class="rule-thick" />

  <!-- 8 · CTA DE CIERRE -->
  <section style="background: var(--color-paper-2);">
    <div class="section-container" style="padding-block: var(--space-3xl); text-align: center;">
      <h4 style="font-size: calc(var(--text-3xl) + 0.5rem); font-weight: 600; line-height: 1.05; max-width: 20ch; margin-inline: auto;">
        ¿Quieres construir tu carrera con nosotros?
      </h4>
      <p style="margin-top: 1.5rem; max-width: 48ch; margin-inline: auto; font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">
        Conoce nuestras vacantes abiertas y da el siguiente paso en un equipo donde el crecimiento es real.
      </p>
      <div style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
        <a href="/vacantes" class="btn-primary">Ver vacantes abiertas</a>
        <a href="/" class="btn-secondary">Volver al inicio</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ---- Galería equipo ---- */
  .dia-dia-item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: var(--rule-hair) solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-paper-2);
  }
  .dia-dia-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .dia-dia-item:hover img { transform: scale(1.04); }
</style>
