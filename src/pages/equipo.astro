---
import Layout from '../layouts/Layout.astro';

const liderazgo = [
  { nombre: 'Gabriel Jerez', cargo: 'Director General', iniciales: 'GJ', descripcion: 'Fundador de Grupo Jesgali. Más de 15 años construyendo equipos y relaciones comerciales en el sector.' },
  { nombre: 'Ana Galindo', cargo: 'Directora de Operaciones', iniciales: 'AG', descripcion: 'Especialista en procesos operativos y cadena de suministro. Garantiza que la maquinaria funcione sin fricciones.' },
  { nombre: 'Roberto Fuentes', cargo: 'Director Comercial', iniciales: 'RF', descripcion: 'Lidera la estrategia de ventas y desarrollo de nuevos mercados. Apasionado por construir equipos comerciales de alto rendimiento.' },
];

const valores = [
  { titulo: 'Integridad', texto: 'Hacemos lo que decimos. Siempre. Con clientes, proveedores y entre nosotros mismos.' },
  { titulo: 'Crecimiento', texto: 'Nos exigimos mejorar constantemente: en procesos, en resultados y como personas.' },
  { titulo: 'Respeto', texto: 'Cada persona en el equipo merece ser escuchada y tratada con dignidad, sin excepción.' },
  { titulo: 'Resultados', texto: 'Medimos lo que hacemos. Los logros concretos nos guían, no las buenas intenciones.' },
];

const beneficios = [
  { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', label: 'Seguro de Gastos Médicos Mayores' },
  { icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z', label: 'Vales de despensa (15% salario)' },
  { icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z', label: 'Fondo de ahorro' },
  { icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', label: 'Vacaciones superiores a la ley' },
  { icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6', label: 'Plan de carrera estructurado' },
  { icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', label: 'Capacitación continua' },
  { icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z', label: 'Ambiente colaborativo y de respeto' },
  { icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2', label: 'Evaluaciones semestrales de desempeño' },
];

const hitos = [
  { año: '2013', evento: 'Fundación de Grupo Jesgali Empresarial en Cuernavaca, Morelos.' },
  { año: '2016', evento: 'Primer equipo comercial de 10 personas. Apertura de nuevas zonas de distribución.' },
  { año: '2019', evento: 'Expansión a nuevos segmentos de mercado. Crecimiento del equipo a 30 colaboradores.' },
  { año: '2022', evento: 'Transformación digital de procesos internos y logística. Nuevo sistema de gestión.' },
  { año: '2024', evento: 'Consolidación como referente del sector. Más de 50 colaboradores en el equipo.' },
];
---

<Layout
  title="Equipo — Grupo Jesgali Empresarial"
  description="Conoce al equipo de Grupo Jesgali, nuestra historia, valores y los beneficios de trabajar con nosotros."
>

  <!-- HERO -->
  <section class="relative bg-gradient-to-br from-brand-950 via-brand-900 to-brand-800 text-white py-28">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 30% 50%, #6366f1, transparent 60%);"></div>
    <div class="section-container relative text-center">
      <h1 class="text-5xl lg:text-6xl font-bold mb-6">Somos Jesgali</h1>
      <p class="text-xl text-brand-200 max-w-2xl mx-auto">
        Un equipo de personas comprometidas con el crecimiento propio y el de la empresa. Conoce quiénes somos, de dónde venimos y hacia dónde vamos.
      </p>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 60" fill="none" class="w-full"><path d="M0 60L1440 60L1440 0C1200 40 720 60 0 0L0 60Z" fill="white"/></svg>
    </div>
  </section>

  <!-- NUESTRA HISTORIA -->
  <section class="py-24 bg-white">
    <div class="section-container">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6">Nuestra historia</h2>
          <p class="text-lg text-slate-600 leading-relaxed mb-4">
            Grupo Jesgali nació en 2013 con una idea clara: construir una empresa donde las personas y los negocios crezcan juntos. Lo que empezó como una operación pequeña en Cuernavaca, Morelos se ha convertido en una empresa con más de 50 colaboradores y presencia en múltiples zonas del país.
          </p>
          <p class="text-slate-500 leading-relaxed">
            A lo largo de estos más de 10 años hemos aprendido que el verdadero activo de una empresa no está en los productos que comercializa, sino en las personas que la hacen funcionar todos los días.
          </p>
        </div>

        <!-- Timeline -->
        <div class="space-y-6">
          {hitos.map((h, i) => (
            <div class="flex gap-4">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-full bg-brand-600 text-white text-xs font-bold flex items-center justify-center shrink-0">
                  {h.año.slice(2)}
                </div>
                {i < hitos.length - 1 && <div class="w-0.5 h-full bg-brand-100 mt-2"></div>}
              </div>
              <div class="pt-2 pb-6">
                <div class="text-sm font-semibold text-brand-600 mb-1">{h.año}</div>
                <p class="text-slate-600">{h.evento}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN Y VALORES -->
  <section class="py-24 bg-slate-50">
    <div class="section-container">
      <h2 class="text-3xl lg:text-4xl font-bold text-slate-900 text-center mb-16">Nuestros compromisos</h2>
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <div class="rounded-2xl bg-brand-600 text-white p-8">
          <h3 class="text-xl font-bold mb-4">Misión</h3>
          <p class="text-brand-100 leading-relaxed">
            Comercializar productos de calidad que mejoren la vida de las familias mexicanas, a través de un equipo apasionado por el servicio y comprometido con la excelencia en cada operación.
          </p>
        </div>
        <div class="rounded-2xl bg-white border border-slate-100 p-8">
          <h3 class="text-xl font-bold text-slate-900 mb-4">Visión</h3>
          <p class="text-slate-500 leading-relaxed">
            Ser la empresa de comercialización de línea blanca de referencia en México, reconocida por la calidad de su equipo, la solidez de sus relaciones comerciales y el impacto positivo en sus colaboradores.
          </p>
        </div>
        <div class="rounded-2xl bg-brand-950 text-white p-8">
          <h3 class="text-xl font-bold mb-4">Propósito</h3>
          <p class="text-brand-200 leading-relaxed">
            Construir carreras, no solo empleos. Cada persona en Jesgali tiene acceso a las herramientas, el apoyo y las oportunidades para crecer de verdad.
          </p>
        </div>
      </div>

      <!-- Valores -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {valores.map(v => (
          <div class="rounded-xl bg-white border border-slate-100 p-6 hover:shadow-md transition">
            <h4 class="font-bold text-slate-900 mb-2">{v.titulo}</h4>
            <p class="text-sm text-slate-500 leading-relaxed">{v.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EL LIDERAZGO -->
  <section class="py-24 bg-white">
    <div class="section-container">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-4">El liderazgo</h2>
        <p class="text-slate-500 text-lg max-w-xl mx-auto">Las personas detrás de las decisiones que definen la empresa.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {liderazgo.map(l => (
          <div class="text-center rounded-2xl border border-slate-100 p-8 hover:shadow-lg transition">
            <div class="w-20 h-20 rounded-full bg-gradient-to-br from-brand-100 to-brand-200 flex items-center justify-center text-brand-700 text-2xl font-bold mx-auto mb-4">
              {l.iniciales}
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-1">{l.nombre}</h3>
            <p class="text-brand-600 text-sm font-medium mb-4">{l.cargo}</p>
            <p class="text-slate-500 text-sm leading-relaxed">{l.descripcion}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="py-24 bg-brand-950 text-white">
    <div class="section-container">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">Beneficios reales</h2>
        <p class="text-brand-300 text-lg max-w-xl mx-auto">Lo que obtienes cuando te unes al equipo, desde el primer día.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {beneficios.map(b => (
          <div class="flex items-center gap-3 rounded-xl bg-brand-900/50 border border-brand-800 p-4">
            <div class="w-9 h-9 rounded-lg bg-brand-700 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={b.icon} />
              </svg>
            </div>
            <span class="text-sm text-brand-200">{b.label}</span>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/vacantes" class="btn-primary text-base py-3 px-8">Ver vacantes abiertas</a>
      </div>
    </div>
  </section>

  <!-- GALERÍA AMBIENTE -->
  <section class="py-24 bg-white">
    <div class="section-container">
      <h2 class="text-3xl font-bold text-slate-900 text-center mb-12">El día a día en Jesgali</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {[
          { from: 'from-brand-100', to: 'to-brand-200', text: 'text-brand-500' },
          { from: 'from-accent-100', to: 'to-accent-200', text: 'text-accent-500' },
          { from: 'from-slate-100', to: 'to-slate-200', text: 'text-slate-400' },
          { from: 'from-brand-200', to: 'to-brand-300', text: 'text-brand-600' },
          { from: 'from-accent-50', to: 'to-accent-100', text: 'text-accent-400' },
          { from: 'from-brand-800', to: 'to-brand-900', text: 'text-brand-300' },
        ].map(c => (
          <div class={`aspect-video rounded-2xl bg-gradient-to-br ${c.from} ${c.to} flex items-center justify-center ${c.text}`}>
            <svg class="w-10 h-10 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-slate-400 mt-4">Imágenes del equipo próximamente</p>
    </div>
  </section>

</Layout>
