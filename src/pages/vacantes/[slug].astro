---
/* Hallmark · genre: editorial · macrostructure: Article/Detail · theme: custom (clay/cream/pine · Fraunces + Hanken Grotesk) · enrichment: none · nav: N6 · footer: Ft1 */
/* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 */
import Layout from '../../layouts/Layout.astro';
import ConfirmationModal from '../../components/ui/ConfirmationModal.astro';
import Field from '../../components/ui/Field.astro';
import VacanteRow from '../../components/ui/VacanteRow.astro';
import { getCollection, render } from 'astro:content';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() ?? '';

export async function getStaticPaths() {
  const vacantes = await getCollection('vacantes', v => v.data.activa);
  return vacantes.map(v => ({
    params: { slug: v.id },
    props: { entry: v },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { titulo, area, tipo, ubicacion, salarioMin, salarioMax, id, resumen } = entry.data;

// Otras vacantes: activas, excluye la actual, máximo 3
const todasVacantes = await getCollection('vacantes', v => v.data.activa && v.id !== entry.id);
todasVacantes.sort((a, b) => b.data.fechaPublicacion.getTime() - a.data.fechaPublicacion.getTime());
const otras = todasVacantes.slice(0, 3);
---

<Layout
  title={`${titulo} — Vacantes Grupo Jesgali Empresarial`}
  description={resumen}
>

  <!-- 1 · HERO -->
  <section class="section-container" style="padding-top: var(--space-2xl); padding-bottom: var(--space-xl);">
    <a href="/vacantes" class="back-link reveal reveal-1" aria-label="Volver a vacantes">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Vacantes
    </a>

    <p class="eyebrow reveal reveal-2" style="margin-top: 2rem; display: inline-flex; align-items: center; gap: 0.5rem;">
      <span style="width: 7px; height: 7px; border-radius: 9999px; background: var(--color-pine); display: inline-block;"></span>
      {area} · {tipo}
    </p>

    <h1 class="reveal reveal-3" style="font-family: var(--font-display); font-weight: 600; font-size: var(--text-display-s); line-height: 1.0; margin-top: 1.25rem; max-width: 18ch; overflow-wrap: anywhere; min-width: 0;">
      {titulo}
    </h1>

    <div class="reveal reveal-3" style="margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem;">
      <span style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--color-accent-deep);">
        ${salarioMin.toLocaleString()} – ${salarioMax.toLocaleString()} <span style="font-size: var(--text-md); color: var(--color-ink-soft); font-family: var(--font-body); font-weight: 400;">/ mes</span>
      </span>
      <span style="font-size: var(--text-md); color: var(--color-ink-soft);">{ubicacion}</span>
    </div>

    <div class="reveal reveal-3" style="margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;">
      <a href="#aplicar" class="btn-primary">Aplicar ahora</a>
      <span class="vacancy-id">Ref. {id}</span>
    </div>

    <p class="reveal reveal-3" style="margin-top: 1.5rem; font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft); max-width: 58ch;">
      {resumen}
    </p>
  </section>

  <hr class="rule-thick" />

  <!-- 2 · DESCRIPCIÓN (markdown body) -->
  <section class="section-container" style="padding-block: var(--space-3xl);">
    <div class="prose-editorial">
      <Content />
    </div>
  </section>

  <hr class="rule-hair" />

  <!-- 3 · FORMULARIO DE APLICACIÓN -->
  <section id="aplicar" style="background: var(--color-paper-2);">
    <div class="section-container" style="padding-block: var(--space-3xl);">
      <div style="max-width: 640px; margin-inline: auto;">
        <p class="eyebrow" style="margin-bottom: 1rem;">Postúlate ahora</p>
        <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; margin-bottom: 1rem; overflow-wrap: anywhere; min-width: 0;">
          ¿Es esta tu siguiente oportunidad?
        </h2>
        <p style="font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft); margin-bottom: var(--space-lg);">
          Completa el formulario. Un integrante de nuestro equipo revisará tu solicitud en menos de 5 días hábiles.
        </p>

        <form
          id="form-aplicar"
          action="https://api.web3forms.com/submit"
          method="POST"
          style="border: var(--rule-hair) solid var(--color-hairline); border-radius: var(--radius-md); padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--color-paper);"
        >
          <input type="hidden" name="access_key" value={web3formsAccessKey} />
          <input type="hidden" name="subject" value={`Aplicación: ${titulo} (${id}) — Jesgali.com.mx`} />
          <input type="hidden" name="from_name" value="Jesgali Sitio Web" />
          <input type="hidden" name="vacante_id" value={id} />
          <input type="hidden" name="vacante_titulo" value={titulo} />
          <input type="checkbox" name="botcheck" style="display: none;" />

          <div class="grid sm:grid-cols-2 gap-5">
            <Field id="a-nombre" name="nombre" label="Nombre completo *" required placeholder="Tu nombre" />
            <Field id="a-email" name="email" type="email" label="Correo electrónico *" required placeholder="tu@correo.com" />
          </div>

          <div class="grid sm:grid-cols-2 gap-5" style="margin-top: 1.25rem;">
            <Field id="a-tel" name="telefono" type="tel" label="Teléfono *" required placeholder="55 1234 5678" />
            <Field id="a-linkedin" name="linkedin" type="url" label="LinkedIn" optionalHint placeholder="linkedin.com/in/tu-perfil" />
          </div>

          <div style="margin-top: 1.25rem;">
            <label class="field-label" for="a-motivo">¿Por qué quieres unirte a Jesgali? *</label>
            <textarea
              id="a-motivo"
              name="motivacion"
              required
              rows="4"
              class="field-input"
              style="resize: vertical; min-height: 7rem;"
              placeholder="Cuéntanos brevemente qué te atrae de esta posición y qué aportarías al equipo..."
            ></textarea>
          </div>

          <p style="font-size: 0.8rem; color: var(--color-ink-soft); margin-top: 1rem; line-height: 1.5;">
            Al enviar este formulario, <strong style="color: var(--color-ink);">adjunta tu CV por correo</strong> a
            <a href={`mailto:contacto@jesgali.com.mx?subject=CV%20${encodeURIComponent(titulo)}%20(${id})`} class="link-underline">contacto@jesgali.com.mx</a>
            con el asunto: CV {titulo} ({id}).
          </p>

          <div style="margin-top: 1.25rem;">
            <label class="consent-label">
              <input type="checkbox" name="consent_privacidad" required class="consent-check" />
              <span>
                He leído y acepto el
                <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer" class="link-underline" style="color: var(--color-accent-deep);">Aviso de Privacidad</a>.
                Consiento que Grupo Jesgali trate mis datos personales para este proceso de selección y posibles vacantes futuras. *
              </span>
            </label>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 1.75rem;">
            Enviar solicitud
          </button>
          <p id="estado-form-aplicar" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- 4 · OTRAS VACANTES -->
  {otras.length > 0 && (
    <section class="section-container" style="padding-block: var(--space-3xl);">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-bottom: var(--space-xl);">
        <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; max-width: 18ch; overflow-wrap: anywhere; min-width: 0;">
          Otras posiciones abiertas
        </h2>
        <a href="/vacantes" class="link-underline" style="font-size: var(--text-md); white-space: nowrap;">Ver todas →</a>
      </div>

      <div>
        {otras.map((v, i) => (
          <VacanteRow vacante={v} compact isFirst={i === 0} />
        ))}
      </div>
    </section>
  )}

  <ConfirmationModal id="modal-aplicar" title="Solicitud recibida">
    <Fragment slot="description">
      Ya tenemos tu información. Para completar tu postulación, <strong style="color: var(--color-ink);">envíanos tu CV por correo</strong>:
    </Fragment>
    <a href="mailto:contacto@jesgali.com.mx" class="link-underline" style="font-size: var(--text-md);">
      contacto@jesgali.com.mx
    </a>
    <p style="font-size: 0.8rem; color: var(--color-ink-soft); margin-top: 0.75rem; line-height: 1.5;">
      Asunto recomendado: <strong>CV {titulo} ({id})</strong>
    </p>
  </ConfirmationModal>

<style>
  /* ---- Enlace volver ---- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    transition: color var(--dur-base) var(--ease-out);
  }
  .back-link:hover { color: var(--color-accent-deep); }

  /* ---- Badge ID de vacante ---- */
  .vacancy-id {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    opacity: 0.65;
  }
</style>

<script>
  import { initWeb3Forms } from '../../scripts/web3forms';
  import { initModal } from '../../scripts/modal';

  const form = document.querySelector<HTMLFormElement>('#form-aplicar');
  const status = document.querySelector<HTMLElement>('#estado-form-aplicar');
  const modal = document.querySelector<HTMLElement>('#modal-aplicar');
  const modalController = modal ? initModal(modal) : null;

  if (form && status) {
    initWeb3Forms({
      form,
      statusElement: status,
      submittingLabel: 'Enviando solicitud…',
      onSuccess: submitter => modalController?.open(submitter),
    });
  }
</script>

</Layout>
