---
import Layout from '../../layouts/Layout.astro';
import ConfirmationModal from '../../components/ui/ConfirmationModal.astro';
import { getCollection } from 'astro:content';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() ?? '';

const vacantes = await getCollection('vacantes', v => v.data.activa);
vacantes.sort((a, b) => b.data.fechaPublicacion.getTime() - a.data.fechaPublicacion.getTime());

const areas = [...new Set(vacantes.map(v => v.data.area))];
const tipos = [...new Set(vacantes.map(v => v.data.tipo))];

const pasos = [
  { num: '01', titulo: 'Aplica', texto: 'Llena el formulario de la vacante que te interesa. Solo toma 3 minutos.' },
  { num: '02', titulo: 'Revisamos tu perfil', texto: 'Un miembro del equipo de RH revisa tu solicitud en menos de 5 días hábiles.' },
  { num: '03', titulo: 'Entrevista', texto: 'Si tu perfil encaja, te contactamos para una entrevista —presencial o en línea.' },
  { num: '04', titulo: 'Bienvenida', texto: 'Si eres la persona correcta, te hacemos la oferta y comenzamos el proceso de incorporación.' },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Index/Listing · theme: custom (clay/cream/pine · Fraunces + Hanken Grotesk) · enrichment: none · nav: N6 · footer: Ft1 -->
<!-- Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 -->

<Layout
  title="Vacantes — Grupo Jesgali Empresarial | Posiciones Abiertas en México"
  description="Explora las posiciones abiertas en Grupo Jesgali. Trabajo de tiempo completo con prestaciones superiores a la ley, plan de carrera real y un equipo que invierte en tu crecimiento."
>

  <!-- 1 · HERO TIPOGRÁFICO -->
  <section class="section-container" style="padding-top: var(--space-2xl); padding-bottom: var(--space-xl); min-height: 58vh; display: flex; flex-direction: column; justify-content: center;">
    <p class="eyebrow reveal reveal-1" style="display: inline-flex; align-items: center; gap: 0.5rem;">
      <span style="width: 7px; height: 7px; border-radius: 9999px; background: var(--color-pine); display: inline-block;"></span>
      {vacantes.length} {vacantes.length === 1 ? 'posición abierta' : 'posiciones abiertas'}
    </p>

    <h1 class="reveal reveal-2" style="font-family: var(--font-display); font-weight: 600; font-size: var(--text-display); line-height: 0.96; margin-top: 1.5rem; max-width: 14ch; overflow-wrap: anywhere; min-width: 0;">
      Encuentra tu <span style="color: var(--color-accent-deep);">lugar</span>
    </h1>

    <p class="reveal reveal-3" style="margin-top: 2rem; max-width: 54ch; font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">
      Posiciones abiertas donde tu talento tiene impacto real. Tiempo completo, prestaciones superiores a la ley y un equipo que invierte en tu crecimiento.
    </p>
  </section>

  <hr class="rule-thick" />

  <!-- 2 · FILTROS + LISTADO -->
  <section class="section-container" style="padding-block: var(--space-3xl);">
    <!-- Filtros -->
    <div id="filtros" style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 1.5rem; margin-bottom: var(--space-xl);">
      <button data-filter="all" class="filter-btn active">Todas</button>
      {areas.map(area => (
        <button data-filter={area} data-type="area" class="filter-btn">{area}</button>
      ))}
      <span style="width: 1px; height: 1rem; background: var(--color-hairline);"></span>
      {tipos.map(tipo => (
        <button data-filter={tipo} data-type="tipo" class="filter-btn">{tipo}</button>
      ))}
    </div>

    <!-- Listado -->
    <div id="vacantes-grid">
      {vacantes.map((v, i) => (
        <a
          href={`/vacantes/${v.id}`}
          data-area={v.data.area}
          data-tipo={v.data.tipo}
          class="vacante-row"
          style={i === 0 ? 'border-top: var(--rule-hair) solid var(--color-hairline);' : ''}
        >
          <div class="vacante-row-inner">
            <div style="min-width: 0;">
              <p class="eyebrow" style="margin-bottom: 0.625rem;">{v.data.area} · {v.data.tipo}</p>
              <h2 style="font-size: var(--text-xl); font-weight: 600; line-height: 1.15; margin-bottom: 0.5rem; overflow-wrap: anywhere; min-width: 0;">
                {v.data.titulo}
              </h2>
              <p style="font-size: var(--text-md); line-height: 1.55; color: var(--color-ink-soft); max-width: 56ch;">{v.data.resumen}</p>
            </div>
            <div class="vacante-row-meta">
              <span style="font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--color-ink); display: block;">
                ${v.data.salarioMin.toLocaleString()} – ${v.data.salarioMax.toLocaleString()}
              </span>
              <span style="font-size: 0.85rem; color: var(--color-ink-soft); display: block; margin-top: 0.25rem;">{v.data.ubicacion}</span>
              <span class="vacante-cta link-underline" style="display: inline-block; margin-top: 1rem;">Ver vacante →</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Sin resultados -->
    <div id="no-results" style="display: none; padding-block: var(--space-2xl); text-align: center;">
      <p style="font-size: var(--text-md); color: var(--color-ink-soft);">No hay vacantes en este filtro por el momento.</p>
      <button data-filter="all" class="filter-btn btn-secondary" style="margin-top: 1.5rem;">Ver todas las vacantes</button>
    </div>
  </section>

  <!-- 3 · PROCESO DE SELECCIÓN (banda oscura) -->
  <section style="background: var(--color-ink-deep); color: var(--color-paper);">
    <div class="section-container" style="padding-block: var(--space-3xl);">
      <div style="max-width: 46ch; margin-bottom: var(--space-xl);">
        <p class="eyebrow" style="color: oklch(80% 0.014 70); margin-bottom: 1rem;">El proceso de selección</p>
        <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; color: var(--color-paper); overflow-wrap: anywhere; min-width: 0;">
          Sin misterios, de principio a fin
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-0">
        {pasos.map(p => (
          <div style="border-top: var(--rule-hair) solid oklch(38% 0.020 50); padding-top: 1.25rem; padding-bottom: 1.5rem;">
            <span style="font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--color-accent); display: block; margin-bottom: 0.75rem;">{p.num}</span>
            <h3 style="font-size: var(--text-lg); font-weight: 600; color: var(--color-paper); margin-bottom: 0.5rem;">{p.titulo}</h3>
            <p style="font-size: var(--text-md); line-height: 1.55; color: oklch(75% 0.012 70);">{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · CV ESPONTÁNEO -->
  <section id="cv-espontaneo" style="background: var(--color-paper-2);">
    <div class="section-container" style="padding-block: var(--space-3xl);">
      <div style="max-width: 640px; margin-inline: auto;">
        <div style="margin-bottom: var(--space-lg);">
          <p class="eyebrow" style="margin-bottom: 1rem;">Candidatura espontánea</p>
          <h2 style="font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; margin-bottom: 1rem; overflow-wrap: anywhere; min-width: 0;">
            ¿No ves tu vacante?
          </h2>
          <p style="font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-soft);">
            Igual queremos conocerte. Déjanos tus datos y te consideramos cuando abra una posición que encaje con tu perfil.
          </p>
        </div>

        <form
          id="form-espontaneo"
          action="https://api.web3forms.com/submit"
          method="POST"
          style="border: var(--rule-hair) solid var(--color-hairline); border-radius: var(--radius-md); padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--color-paper);"
        >
          <input type="hidden" name="access_key" value={web3formsAccessKey} />
          <input type="hidden" name="subject" value="CV Espontáneo — Jesgali.com.mx" />
          <input type="hidden" name="from_name" value="Jesgali Sitio Web" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="field-label" for="f-nombre">Nombre completo *</label>
              <input id="f-nombre" type="text" name="nombre" required class="field-input" />
            </div>
            <div>
              <label class="field-label" for="f-email">Email *</label>
              <input id="f-email" type="email" name="email" required class="field-input" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5" style="margin-top: 1.25rem;">
            <div>
              <label class="field-label" for="f-area">Área de interés</label>
              <select id="f-area" name="area_interes" class="field-input">
                <option value="">Selecciona un área</option>
                <option>Ventas</option>
                <option>Operaciones</option>
                <option>Recursos Humanos</option>
                <option>Marketing</option>
                <option>Administración</option>
                <option>Otro</option>
              </select>
            </div>
            <div>
              <label class="field-label" for="f-linkedin">LinkedIn (opcional)</label>
              <input id="f-linkedin" type="url" name="linkedin" placeholder="linkedin.com/in/tu-perfil" class="field-input" />
            </div>
          </div>

          <div style="margin-top: 1.25rem;">
            <label class="field-label" for="f-motivacion">¿Por qué te gustaría trabajar en Jesgali?</label>
            <textarea id="f-motivacion" name="motivacion" rows="4" class="field-input" style="resize: none;"></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1.5rem;">
            Enviar información
          </button>
          <p id="estado-form-espontaneo" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <ConfirmationModal id="modal-cv" title="¡Gracias por tu interés!">
    <Fragment slot="description">
      Recibimos tu información. Para completar tu solicitud, <strong style="color: var(--color-ink);">envíanos tu CV por correo</strong>:
    </Fragment>
    <a href="mailto:contacto@jesgali.com.mx?subject=CV%20Espontáneo" class="link-underline" style="font-size: var(--text-md);">
      contacto@jesgali.com.mx
    </a>
    <p style="font-size: 0.85rem; color: var(--color-ink-soft); margin-top: 0.75rem;">Te contactaremos cuando tengamos una posición que encaje con tu perfil.</p>
  </ConfirmationModal>

<style>
  /* ---- Filtros editoriales (texto, no pills) ---- */
  .filter-btn {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    position: relative;
    transition: color var(--dur-base) var(--ease-out);
  }
  .filter-btn::after {
    content: '';
    position: absolute;
    left: 0; bottom: -4px;
    width: 100%; height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .filter-btn:hover { color: var(--color-ink); }
  .filter-btn.active { color: var(--color-accent-deep); }
  .filter-btn.active::after { transform: scaleX(1); }

  /* ---- Fila de vacante ---- */
  .vacante-row {
    display: block;
    border-bottom: var(--rule-hair) solid var(--color-hairline);
    transition: background var(--dur-base) var(--ease-out);
  }
  .vacante-row:hover { background: var(--color-paper-2); }
  .vacante-row-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: var(--space-lg);
    padding-inline: clamp(0.5rem, 2vw, 1.5rem);
  }
  .vacante-row-meta { text-align: left; }
  .vacante-row:hover .vacante-cta::after { transform: scaleX(1); }

  @media (min-width: 768px) {
    .vacante-row-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 2.5rem;
    }
    .vacante-row-meta { text-align: right; min-width: 12rem; }
  }

  /* ---- Campos de formulario ---- */
  .field-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }
  .field-input {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-ink);
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 0.7rem 0.9rem;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .field-input:hover { border-color: var(--color-ink-soft); }
  .field-input:focus { outline: none; border-color: var(--color-accent-deep); box-shadow: 0 0 0 3px var(--color-accent-soft); }

</style>

<script>
  import { initWeb3Forms } from '../../scripts/web3forms';
  import { initModal } from '../../scripts/modal';

  // ---- Filtros ----
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.vacante-row');
  const noResults = document.getElementById('no-results');

  function applyFilter(filter: string) {
    let visible = 0;
    cards.forEach(card => {
      const match = filter === 'all' || card.dataset.area === filter || card.dataset.tipo === filter;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (noResults) noResults.style.display = visible > 0 ? 'none' : 'block';
    buttons.forEach(btn => {
      btn.classList.toggle('active', btn.dataset.filter === filter);
    });
  }

  buttons.forEach(btn => btn.addEventListener('click', () => applyFilter(btn.dataset.filter || 'all')));

  // ---- Modal CV espontáneo ----
  const form = document.querySelector<HTMLFormElement>('#form-espontaneo');
  const status = document.querySelector<HTMLElement>('#estado-form-espontaneo');
  const modal = document.querySelector<HTMLElement>('#modal-cv');
  const modalController = modal ? initModal(modal) : null;

  if (form && status) {
    initWeb3Forms({
      form,
      statusElement: status,
      submittingLabel: 'Enviando información…',
      onSuccess: submitter => modalController?.open(submitter),
    });
  }
</script>

</Layout>
